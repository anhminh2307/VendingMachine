{
  "expo": {
    "scheme": "vendingmachineapp",
    "name": "VendingMachine_app",
    "slug": "VendingMachine_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },

    "plugins": 
    [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập ảnh để đặt avatar.",
          "cameraPermission": "Ứng dụng cần quyền camera để chụp ảnh avatar."
        }
      ]
    ]
  }
}
